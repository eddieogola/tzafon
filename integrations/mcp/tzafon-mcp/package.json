{
  "name": "tzafon-mcp",
  "version": "1.0.0",
  "description": "Tzafon MCP Server",
  "scripts": {
    "build:stdio": "tsc && tsc-alias && chmod 755 build/stdio.js",
    "build:server": "tsc && tsc-alias && chmod 755 build/server.js",
    "start:stdio": "pnpm run build:stdio && node build/stdio.js",
    "start:server": "pnpm run build:server && node build/server.js",
    "dev:stdio": "tsx watch src/stdio.ts",
    "dev:server": "tsx watch src/server.ts",
    "inspect:stdio": "npx @modelcontextprotocol/inspector node build/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": "prettier --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.2",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "pino": "^10.1.0",
    "tzafon": "^1.14.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.18.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
