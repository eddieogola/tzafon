{
  "name": "tzafon-mcp",
  "version": "1.0.0",
  "description": "Tzafon MCP Server",
  "scripts": {
    "build:stdio": "tsc && tsc-alias && chmod 755 build/stdio.js",
    "build:server": "tsc && tsc-alias && chmod 755 build/server.js",
    "start:stdio": "pnpm run build:stdio && node build/stdio.js",
    "start:server": "pnpm run build:server && node build/server.js",
    "dev:stdio": "tsx watch src/stdio.ts",
    "dev:server": "tsx watch src/server.ts",
    "inspect:stdio": "npx @modelcontextprotocol/inspector node build/stdio.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.2",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "pino": "^10.1.0",
    "tzafon": "^1.14.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.18.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
